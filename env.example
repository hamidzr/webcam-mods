# Startup capture/output settings. Runtime crop/padding lives in ~/.webcam-mods.conf.
VIDEO_IN=0
# Linux V4L2 output only; macOS keeps OBS/pyvirtualcam output.
VIDEO_OUT=/dev/video10
IN_WIDTH=640
IN_HEIGHT=480
IN_FORMAT=YUYV
# Requested camera FPS; device must support resolution and rate together.
IN_FPS=30
# Output dimensions are independent of input; aspect ratio is padded to fit.
OUT_WIDTH=640
OUT_HEIGHT=480
# Output FPS cap; repeat mode delivers independently of input/processing FPS.
MAX_OUT_FPS=30
# Opt in to independent delivery, repeating latest completed frame.
REPEAT_FRAMES=False
# Fresh-frame processing cap in repeat mode, also limited by input/output FPS.
PROCESSING_FPS=30
# Shared loading/paused picture: color-bars (default) or noise.
SIGNAL_PATTERN=color-bars
# Booleans accept true/false (case-insensitive) or 1/0. CLI options override env.
ON_DEMAND=False
PAN_CONTROL=True
PADDING_CONTROL=True
# Common CLI option. Use --no-controls to disable keyboard and stdin together.
freeze_on_error=False
# Optional model cache location; default is ~/.cache.
# XDG_CACHE_HOME=/path/to/cache
# Optional profiles DB root; stored at $XDG_CONFIG_HOME/webcam_mods/profiles.sqlite3, default ~/.config.
# XDG_CONFIG_HOME=/path/to/config
